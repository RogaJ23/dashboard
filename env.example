# Copy to .env and fill in. NEVER commit .env.

# Neon / Supabase connection string
DATABASE_URL=postgresql://user:password@host/dbname

# Set to true ONLY on the public demo deployment (disables writes, shows banner)
DEMO_MODE=false
TZ_NAME=America/Los_Angeles

# Spotify (https://developer.spotify.com/dashboard, owner needs Premium)
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Gradescope (your own account only)
GRADESCOPE_EMAIL=
GRADESCOPE_PASSWORD=
